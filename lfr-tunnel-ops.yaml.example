# Copy this file to lfr-tunnel-ops.yaml (gitignored -- it's specific to your own
# deployment) and fill in your actual central VPS details.
#
# Every lfr-tunnel-ops command that talks to the central VPS (deploy, deploy-clients,
# maintenance, diagnose, reconcile-nginx) resolves its target through the same three
# sources, in this order of precedence: a CLI flag, then an environment variable
# (VPS_USER / VPS_IP / LFT_IDENTITY_FILE), then this file. None of them carry a
# hardcoded default of their own -- see .agents/skills/lfr-tunnel-ops/SKILL.md for the
# full command reference.
#
# This file is entirely optional: if you'd rather set VPS_USER/VPS_IP/LFT_IDENTITY_FILE
# in your shell profile (or pass -i/-u/-s flags every time), you don't need it at all.
#
# ---------------------------------------------------------------------------------------
# Option A: single target (most setups -- one operator, one central VPS)
# ---------------------------------------------------------------------------------------

central:
  # SSH username on the central VPS.
  user: ubuntu
  # SSH host -- an IP address or a hostname.
  host: central.example.com
  # Path to your SSH private key for that host. ~ is expanded to your home directory.
  identity_file: ~/.ssh/my-central-key.pem

# Only needed for `lfr-tunnel-ops reconcile-nginx`.
nginx:
  # Every domain group this central actually serves. Check the existing
  # server_name lines in /etc/nginx/sites-available/lfr-tunnel on the box itself if
  # you're not sure which ones are live.
  domains:
    - central.example.com
  # Local port lfr-tunneld binds to -- must match the live server-config.yaml's
  # http_bind_addr port.
  port: "8080"

# ---------------------------------------------------------------------------------------
# Option B: multiple named targets (managing more than one environment, e.g.
# staging/production, from the same checkout). Uncomment this block and delete the
# central:/nginx: block above -- a file should use one shape or the other, not both.
#
# Select which target a command uses with -target <name> or the LFT_OPS_TARGET env var
# (same precedence order as everything else: flag wins over env var). If the file
# defines exactly one target, it's used automatically without needing to select it. If
# it defines more than one and neither -target nor LFT_OPS_TARGET is set, every command
# errors out listing the available names rather than guessing which one you meant.
# ---------------------------------------------------------------------------------------

# targets:
#   production:
#     central:
#       user: ubuntu
#       host: prod-central.example.com
#       identity_file: ~/.ssh/prod-central-key.pem
#     nginx:
#       domains:
#         - prod-central.example.com
#       port: "8080"
#   staging:
#     central:
#       user: ubuntu
#       host: staging-central.example.com
#       identity_file: ~/.ssh/staging-central-key.pem
#     nginx:
#       domains:
#         - staging-central.example.com
#       port: "8080"
