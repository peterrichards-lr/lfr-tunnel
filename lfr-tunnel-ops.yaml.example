# Copy this file to lfr-tunnel-ops.yaml (gitignored -- it's specific to your own
# deployment) and fill in your actual central VPS details.
#
# Every lfr-tunnel-ops command that talks to the central VPS (deploy, deploy-clients,
# maintenance, diagnose, reconcile-nginx) resolves its target through the same three
# sources, in this order of precedence: a CLI flag, then an environment variable
# (VPS_USER / VPS_IP / LFT_IDENTITY_FILE), then this file. None of them carry a
# hardcoded default of their own -- see .agents/skills/lfr-tunnel-ops/SKILL.md for the
# full command reference.
#
# This file is entirely optional: if you'd rather set VPS_USER/VPS_IP/LFT_IDENTITY_FILE
# in your shell profile (or pass -i/-u/-s flags every time), you don't need it at all.
#
# ---------------------------------------------------------------------------------------
# Client build defaults (file-level -- applies to every target)
# ---------------------------------------------------------------------------------------
#
# The URLs compiled into client binaries by `lfr-tunnel-ops build`. Environment variables
# win over this block: LFT_DEFAULT_SERVER_URL, LFT_DEFAULT_STATUS_PAGE_URL and
# LFT_DEFAULT_PORTAL_URL, which is how the release workflow supplies them from repository
# variables.
#
# server_url matters most. A client built without it has no gateway to start from, so every
# user has to pass -server -- and -server PINS the client to that one gateway, switching off
# both the closest-gateway election and failover. `build`, `sign` and `deploy-clients` all
# refuse rather than produce one; pass -allow-no-default if that is genuinely what you want.
#
# This block is file-level on purpose: `build` produces one dist/ that every target
# publishes, so there is no per-target answer to give.
#
# client_defaults:
#   server_url: https://tunnel.example.com
#   status_page_url: https://status.example.com
#   # Optional. Unset means browser login falls back to the gateway, which serves the portal.
#   portal_url: https://tunnel.example.com/portal

# ---------------------------------------------------------------------------------------
# Option A: single target (most setups -- one operator, one central VPS)
# ---------------------------------------------------------------------------------------

central:
  # SSH username on the central VPS.
  user: ubuntu
  # SSH host -- an IP address or a hostname.
  host: central.example.com
  # Path to your SSH private key for that host. ~ is expanded to your home directory.
  identity_file: ~/.ssh/my-central-key.pem
  # Optional (#1050, #1187). Only `deploy` uses this, and only if set: if the target
  # machine is stopped (e.g. an edge caught inside a scheduled power-off window), deploy
  # starts it, waits for SSH, deploys, then stops it back afterward -- whether the deploy
  # succeeds or fails. Leave unset (or omit the line) to never touch power state at all.
  #
  # power_hook is the script that actually reads and changes the power state. lfr-tunnel
  # itself knows nothing about any cloud provider -- it only knows the hook's contract --
  # so running somewhere other than AWS means writing a script, not patching Go:
  #
  #   <hook> status <host>   print "<state> [id]", exit 0
  #   <hook> start  <host>   start it, return only once it is running
  #   <hook> stop   <host>   request a stop, return once accepted
  #
  # A reference implementation for AWS EC2 ships in the repo. Can also be set via the
  # LFT_POWER_HOOK env var.
  # power_hook: scripts/common/lfr-power-hook-aws.sh

  # Passed to the hook as AWS_REGION. Required by the bundled AWS hook; whether your own
  # hook needs it is up to your hook. Can also be set via -aws-region or AWS_REGION.
  #
  # Setting this without a power_hook is an error rather than a silent no-op: it used to
  # be the whole switch for power management, and quietly leaving a started node running
  # is exactly the failure the restore check exists to catch (#1183).
  # aws_region: eu-west-1

  # Optional, and only used alongside a power_hook. Passed through as LFT_INSTANCE_TAG.
  # The bundled AWS hook uses it to narrow the instance lookup to resources carrying this
  # tag, written Key=Value. Without it that lookup matches on public address alone, so a
  # mis-set region or a stale DNS record could in principle find an unrelated instance
  # that happens to share an address.
  #
  # There is deliberately no default. A tag value names one particular deployment, and
  # this file carries no values of its own -- the operator is the only one who knows
  # what their own resources are tagged with. Can also be set via LFT_INSTANCE_TAG.
  # instance_tag: Project=my-tunnel

# Only needed for `lfr-tunnel-ops reconcile-nginx`.
# The portal session policy this deployment intends (#1681).
#
# Declared here rather than committed to the repo: these are deployment decisions, not project
# ones -- a staging gateway may reasonably want shorter sessions than production.
#
# `lfr-tunnel-ops reconcile-server-config` applies these to a running gateway, and
# `check-config` reports when a live box has drifted from them. deploy does NOT push config, so
# without this a setting reached a box only on initial provision or by hand.
#
# Both are optional; omit either to leave that setting alone.
#   portal_session_duration     -- idle timeout, slides on use
#   portal_session_max_lifetime -- absolute cap from login, whatever the activity
#
# PLACEMENT: this sits beside central: and nginx:, so in a MULTI-target file it belongs INSIDE
# the target entry (targets: -> <name>: -> session:), not at the top level. Put at the top level
# of a multi-target file it is silently ignored -- the file still parses, reconcile-server-config
# just reports "no session: block declared" and does nothing.
session:
  portal_session_duration: "8h"
  portal_session_max_lifetime: "24h"

nginx:
  # APEX domains, not hostnames. Each entry generates TWO server blocks -- `example.com` and
  # `*.example.com` -- and reads its certificate from /etc/letsencrypt/live/<entry>/. So the
  # entry has to be the name the wildcard certificate was issued for, which is the apex. Put
  # a hostname here and nginx is asked for a certificate directory that does not exist.
  #
  # List EVERY domain group the box serves. The generated config replaces the whole file, so an
  # entry left out is a vhost deleted -- a single-entry list on a two-domain gateway silently
  # removes the second domain. reconcile-nginx runs `nginx -t` and rolls back on failure, but a
  # config that is merely INCOMPLETE passes `nginx -t` and applies cleanly.
  #
  # Check the live `server_name` lines before editing this:
  #   sudo grep -E "server_name|ssl_certificate " /etc/nginx/sites-available/lfr-tunnel
  domains:
    - example.com
  # Local port lfr-tunneld binds to -- must match the live server-config.yaml's
  # http_bind_addr port.
  port: "8080"

# ---------------------------------------------------------------------------------------
# Option B: multiple named targets (managing more than one environment, e.g.
# staging/production, from the same checkout). Uncomment this block and delete the
# central:/nginx: block above -- a file should use one shape or the other, not both.
#
# Select which target a command uses with -target <name> or the LFT_OPS_TARGET env var
# (same precedence order as everything else: flag wins over env var). If the file
# defines exactly one target, it's used automatically without needing to select it. If
# it defines more than one and neither -target nor LFT_OPS_TARGET is set, every command
# errors out listing the available names rather than guessing which one you meant.
# ---------------------------------------------------------------------------------------

# targets:
#   production:
#     central:
#       user: ubuntu
#       host: prod-central.example.com
#       identity_file: ~/.ssh/prod-central-key.pem
#     nginx:
#       domains:
#         - prod-central.example.com
#       port: "8080"
#   staging:
#     central:
#       user: ubuntu
#       host: staging-central.example.com
#       identity_file: ~/.ssh/staging-central-key.pem
#     nginx:
#       domains:
#         - staging-central.example.com
#       port: "8080"
