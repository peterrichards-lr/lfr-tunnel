# Optional AWS resource tagging overlay for scripts/provision-aws-ec2.sh.
#
# This file is NOT required to use lfr-tunnel on AWS — it exists purely so Liferay's
# internal cost-allocation conventions don't need to be hardcoded into this OSS repo.
# Copy this file to `liferay-tags.env` (git-ignored) in this same directory and fill in
# real values; provision-aws-ec2.sh sources it automatically if present.
#
# All resources across every central/edge instance should share LFR_TAG_PROJECT so a
# single AWS Resource Group (tag:Project=lfr-tunnel) covers the whole deployment — use
# --role central|edge on provision-aws-ec2.sh to filter within that group.

LFR_TAG_PROJECT="lfr-tunnel"
LFR_TAG_OWNER="your-name-or-email"
LFR_TAG_TEAM="your-team-name"
# Optional — leave unset/blank if you don't have one yet; the script skips this tag
# entirely when empty.
LFR_TAG_COST_CENTER=""
